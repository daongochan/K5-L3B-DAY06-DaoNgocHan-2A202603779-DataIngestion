# Local-only connection for the provided Docker Compose setup.
# If host port 55433 is unavailable (on Windows, Hyper-V can reserve 55425-55624),
# set DAY6_PG_PORT to a free port and use the same port below.
# DAY6_PG_PORT=55433
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=
